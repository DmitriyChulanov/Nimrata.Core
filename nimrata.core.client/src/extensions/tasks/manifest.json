{
    "extension": "tasks",
    "version": 20,
    "name": "Трекер задач",
    "description": "Задачи по годам, месяцам и дням: категории, повторы, выбор текущего дня и уведомления.",
    "icon": "list-checks",
    "defaultEnabled": true,
    "commands": [
        {
            "id": "selectToday",
            "name": "Выделить текущий день",
            "description": "Показывает в дереве сегодняшний день «Текущих задач».",
            "icon": "crosshair"
        },
        {
            "id": "completedReport",
            "name": "Отчёт по завершённым задачам",
            "description": "Формирует и скачивает .xlsx со сводкой завершённых задач за период.",
            "icon": "file-spreadsheet",
            "parameters": [
                {
                    "id": "start",
                    "name": "Начало",
                    "kind": "date",
                    "required": true
                },
                {
                    "id": "end",
                    "name": "Конец",
                    "kind": "date",
                    "required": true
                }
            ]
        },
        {
            "id": "createSchedule",
            "name": "Создать расписание",
            "description": "Создаёт месяцы и дни периода в «Текущих задачах» и достраивает повторы. Пустое начало — сегодня, пустой конец — конец года.",
            "icon": "calendar-range",
            "parameters": [
                {
                    "id": "start",
                    "name": "Начало",
                    "kind": "date"
                },
                {
                    "id": "end",
                    "name": "Конец",
                    "kind": "date"
                }
            ]
        }
    ],
    "types": [
        {
            "id": "TasksRoot",
            "name": "Задачи",
            "sealed": true,
            "singleton": true,
            "allowedChildren": ["CurrentTasksRoot", "CompletedTasksRoot"],
            "icon": "list-checks",
            "iconColor": "blue"
        },
        {
            "id": "CurrentTasksRoot",
            "name": "Текущие задачи",
            "sealed": true,
            "singleton": true,
            "allowedChildren": ["Month"],
            "actions": [
                {
                    "id": "createTask",
                    "name": "Создать задачу",
                    "icon": "plus",
                    "parameters": [
                        {
                            "id": "name",
                            "name": "Имя",
                            "kind": "string",
                            "required": true
                        },
                        {
                            "id": "date",
                            "name": "Дата",
                            "kind": "date"
                        },
                        {
                            "id": "category",
                            "name": "Категория",
                            "kind": "string"
                        }
                    ]
                }
            ],
            "icon": "list-todo",
            "iconColor": "blue"
        },
        {
            "id": "CompletedTasksRoot",
            "name": "Завершённые задачи",
            "sealed": true,
            "singleton": true,
            "allowedChildren": ["Year"],
            "icon": "circle-check",
            "iconColor": "green"
        },
        {
            "id": "Year",
            "name": "Год",
            "sealed": true,
            "allowedChildren": ["Month"],
            "properties": [
                {
                    "id": "name",
                    "name": "Имя",
                    "kind": "string",
                    "category": "Основное",
                    "readOnly": true
                },
                {
                    "id": "date",
                    "name": "Дата",
                    "kind": "date",
                    "category": "Основное",
                    "readOnly": true
                }
            ],
            "icon": "calendar-range",
            "iconColor": "orange"
        },
        {
            "id": "Month",
            "name": "Месяц",
            "sealed": true,
            "allowedChildren": ["Day", "DayOff"],
            "properties": [
                {
                    "id": "name",
                    "name": "Имя",
                    "kind": "string",
                    "category": "Основное",
                    "readOnly": true
                },
                {
                    "id": "date",
                    "name": "Дата",
                    "kind": "date",
                    "category": "Основное",
                    "readOnly": true
                }
            ],
            "icon": "calendar-days",
            "iconColor": "orange"
        },
        {
            "id": "Day",
            "name": "День",
            "sealed": true,
            "allowedChildren": ["Task", "Category"],
            "properties": [
                {
                    "id": "name",
                    "name": "Имя",
                    "kind": "string",
                    "category": "Основное",
                    "readOnly": true
                },
                {
                    "id": "date",
                    "name": "Дата",
                    "kind": "date",
                    "category": "Основное",
                    "readOnly": true
                }
            ],
            "actions": [
                {
                    "id": "createTask",
                    "name": "Создать задачу",
                    "icon": "plus",
                    "placements": ["propertyGrid", "contextMenu"],
                    "parameters": [
                        {
                            "id": "name",
                            "name": "Имя",
                            "kind": "string",
                            "required": true
                        },
                        {
                            "id": "template",
                            "name": "Типовая категория",
                            "kind": "enum",
                            "default": "none",
                            "values": [
                                {
                                    "value": "none",
                                    "name": "Без категории"
                                }
                            ]
                        }
                    ],
                    "category": "Основное"
                }
            ],
            "icon": "calendar-1",
            "iconColor": "orange"
        },
        {
            "id": "DayOff",
            "name": "День-выходной",
            "sealed": true,
            "allowedChildren": ["Task", "Category"],
            "properties": [
                {
                    "id": "name",
                    "name": "Имя",
                    "kind": "string",
                    "category": "Основное",
                    "readOnly": true
                },
                {
                    "id": "date",
                    "name": "Дата",
                    "kind": "date",
                    "category": "Основное",
                    "readOnly": true
                }
            ],
            "actions": [
                {
                    "id": "createTask",
                    "name": "Создать задачу",
                    "icon": "plus",
                    "placements": ["propertyGrid", "contextMenu"],
                    "parameters": [
                        {
                            "id": "name",
                            "name": "Имя",
                            "kind": "string",
                            "required": true
                        },
                        {
                            "id": "template",
                            "name": "Типовая категория",
                            "kind": "enum",
                            "default": "none",
                            "values": [
                                {
                                    "value": "none",
                                    "name": "Без категории"
                                }
                            ]
                        }
                    ],
                    "category": "Основное"
                }
            ],
            "icon": "palmtree",
            "iconColor": "green"
        },
        {
            "id": "Category",
            "name": "Категория",
            "sealed": true,
            "allowedChildren": ["Task", "Category"],
            "properties": [
                {
                    "id": "name",
                    "name": "Имя",
                    "kind": "string",
                    "category": "Основное"
                }
            ],
            "actions": [
                {
                    "id": "createTask",
                    "name": "Создать задачу",
                    "icon": "plus",
                    "placements": ["propertyGrid", "contextMenu"],
                    "parameters": [
                        {
                            "id": "name",
                            "name": "Имя",
                            "kind": "string",
                            "required": true
                        }
                    ],
                    "category": "Основное"
                },
                {
                    "id": "postpone",
                    "name": "Отложить",
                    "icon": "clock",
                    "placements": ["propertyGrid", "contextMenu"],
                    "parameters": [
                        {
                            "id": "date",
                            "name": "Дата",
                            "kind": "date",
                            "required": true
                        }
                    ],
                    "category": "Основное"
                }
            ],
            "icon": "tag",
            "iconColor": "gray"
        },
        {
            "id": "Task",
            "name": "Задача",
            "sealed": true,
            "allowedChildren": [],
            "properties": [
                {
                    "id": "name",
                    "name": "Имя",
                    "kind": "string",
                    "category": "Основное",
                    "order": 1
                },
                {
                    "id": "time",
                    "name": "Время",
                    "kind": "time",
                    "category": "Уведомления",
                    "order": 8
                },
                {
                    "id": "comment",
                    "name": "Комментарий",
                    "kind": "text",
                    "category": "Основное",
                    "order": 3
                },
                {
                    "id": "priority",
                    "name": "Приоритет",
                    "kind": "enum",
                    "category": "Основное",
                    "default": "low",
                    "values": [
                        {
                            "value": "low",
                            "name": "Низкий"
                        },
                        {
                            "value": "medium",
                            "name": "Средний"
                        },
                        {
                            "value": "high",
                            "name": "Высокий"
                        }
                    ],
                    "order": 4
                },
                {
                    "id": "status",
                    "name": "Статус",
                    "kind": "enum",
                    "category": "Основное",
                    "values": [
                        {
                            "value": "completed",
                            "name": "Завершена"
                        }
                    ],
                    "order": 5
                },
                {
                    "id": "notifyBefore",
                    "name": "Уведомить за (мин)",
                    "kind": "integer",
                    "category": "Уведомления",
                    "order": 9
                },
                {
                    "id": "link",
                    "name": "Внешняя ссылка",
                    "kind": "string",
                    "category": "Ссылки",
                    "order": 11
                },
                {
                    "id": "internalLink",
                    "name": "Внутренняя ссылка",
                    "kind": "reference",
                    "category": "Ссылки",
                    "order": 13
                },
                {
                    "id": "repeat",
                    "name": "Повтор",
                    "kind": "enum",
                    "category": "Повтор",
                    "default": "none",
                    "values": [
                        {
                            "value": "none",
                            "name": "Нет"
                        },
                        {
                            "value": "weekdays",
                            "name": "Каждый будний день"
                        },
                        {
                            "value": "weekly",
                            "name": "Каждую неделю"
                        },
                        {
                            "value": "monthly",
                            "name": "Каждый месяц"
                        }
                    ],
                    "order": 10
                },
                {
                    "id": "repeatId",
                    "name": "Идентификатор повтора",
                    "kind": "string",
                    "category": "Повтор",
                    "hidden": true
                }
            ],
            "actions": [
                {
                    "id": "openExternalLink",
                    "name": "Перейти по внешней ссылке",
                    "icon": "globe",
                    "placements": ["propertyGrid", "contextMenu"],
                    "category": "Ссылки",
                    "order": 12
                },
                {
                    "id": "openInternalLink",
                    "name": "Перейти по внутренней ссылке",
                    "icon": "link",
                    "placements": ["propertyGrid", "contextMenu"],
                    "category": "Ссылки",
                    "order": 14
                },
                {
                    "id": "complete",
                    "name": "Завершить",
                    "icon": "circle-check",
                    "placements": ["propertyGrid", "contextMenu"],
                    "category": "Основное",
                    "order": 6
                },
                {
                    "id": "postpone",
                    "name": "Отложить",
                    "icon": "clock",
                    "placements": ["propertyGrid", "contextMenu"],
                    "parameters": [
                        {
                            "id": "date",
                            "name": "Дата",
                            "kind": "date",
                            "required": true
                        }
                    ],
                    "category": "Основное",
                    "order": 7
                }
            ],
            "colorRules": [
                {
                    "property": "priority",
                    "equals": "medium",
                    "color": "orange"
                },
                {
                    "property": "priority",
                    "equals": "high",
                    "color": "red"
                },
                {
                    "property": "status",
                    "equals": "completed",
                    "color": "green"
                }
            ],
            "icon": "square-check-big",
            "iconColor": "blue"
        },
        {
            "id": "TasksSettings",
            "name": "Трекер задач",
            "sealed": true,
            "singleton": true,
            "allowedChildren": ["CategoryTemplates"],
            "icon": "settings",
            "iconColor": "gray"
        },
        {
            "id": "CategoryTemplates",
            "name": "Категории задач",
            "sealed": true,
            "singleton": true,
            "allowedChildren": ["CategoryTemplate"],
            "icon": "tag",
            "iconColor": "gray"
        },
        {
            "id": "CategoryTemplate",
            "name": "Типовая категория",
            "sealed": true,
            "allowedChildren": [],
            "properties": [
                {
                    "id": "name",
                    "name": "Имя",
                    "kind": "string",
                    "category": "Основное"
                }
            ],
            "icon": "tag",
            "iconColor": "gray"
        }
    ]
}
