{
    "module": "tracker",
    "version": 2,
    "types": [
        {
            "id": "TasksRoot",
            "name": "Задачи",
            "sealed": true,
            "allowedChildren": []
        },
        {
            "id": "CurrentTasksRoot",
            "name": "Текущие задачи",
            "sealed": true,
            "allowedChildren": []
        },
        {
            "id": "CompletedTasksRoot",
            "name": "Завершённые задачи",
            "sealed": true,
            "allowedChildren": []
        },
        {
            "id": "NotesRoot",
            "name": "Заметки",
            "sealed": true,
            "allowedChildren": ["Note", "NoteGroup"],
            "actions": [
                {
                    "id": "createNote",
                    "name": "Создать заметку",
                    "placements": ["contextMenu"],
                    "parameters": [
                        {
                            "id": "title",
                            "name": "Название",
                            "kind": "string",
                            "required": true
                        }
                    ]
                },
                {
                    "id": "createNoteGroup",
                    "name": "Создать группу заметок",
                    "placements": ["contextMenu"],
                    "parameters": [
                        {
                            "id": "name",
                            "name": "Название",
                            "kind": "string",
                            "required": true
                        }
                    ]
                }
            ]
        },
        {
            "id": "NoteGroup",
            "name": "Группа заметок",
            "allowedChildren": ["Note", "NoteGroup"],
            "properties": [
                {
                    "id": "name",
                    "name": "Название",
                    "kind": "string",
                    "category": "Основное"
                }
            ],
            "actions": [
                {
                    "id": "createNote",
                    "name": "Создать заметку",
                    "placements": ["contextMenu"],
                    "parameters": [
                        {
                            "id": "title",
                            "name": "Название",
                            "kind": "string",
                            "required": true
                        }
                    ]
                },
                {
                    "id": "createNoteGroup",
                    "name": "Создать группу заметок",
                    "placements": ["contextMenu"],
                    "parameters": [
                        {
                            "id": "name",
                            "name": "Название",
                            "kind": "string",
                            "required": true
                        }
                    ]
                }
            ]
        },
        {
            "id": "Note",
            "name": "Заметка",
            "sealed": true,
            "allowedChildren": [],
            "properties": [
                {
                    "id": "title",
                    "name": "Название",
                    "kind": "string",
                    "category": "Основное"
                },
                {
                    "id": "name",
                    "name": "Имя",
                    "kind": "string",
                    "category": "Основное",
                    "readOnly": true
                },
                {
                    "id": "comment",
                    "name": "Комментарий",
                    "kind": "text",
                    "category": "Основное"
                },
                {
                    "id": "priority",
                    "name": "Приоритет",
                    "kind": "enum",
                    "category": "Основное",
                    "default": "low",
                    "values": [
                        {
                            "value": "low",
                            "name": "Низкий"
                        },
                        {
                            "value": "medium",
                            "name": "Средний"
                        },
                        {
                            "value": "high",
                            "name": "Высокий"
                        }
                    ]
                },
                {
                    "id": "status",
                    "name": "Статус",
                    "kind": "enum",
                    "category": "Основное",
                    "values": [
                        {
                            "value": "completed",
                            "name": "Завершена"
                        }
                    ]
                },
                {
                    "id": "link",
                    "name": "Внешняя ссылка",
                    "kind": "string",
                    "category": "Ссылки"
                }
            ],
            "actions": [
                {
                    "id": "openExternalLink",
                    "name": "Перейти по внешней ссылке",
                    "placements": ["propertyGrid", "contextMenu"]
                }
            ],
            "colorRules": [
                {
                    "property": "priority",
                    "equals": "medium",
                    "color": "orange"
                },
                {
                    "property": "priority",
                    "equals": "high",
                    "color": "red"
                },
                {
                    "property": "status",
                    "equals": "completed",
                    "color": "green"
                }
            ]
        }
    ]
}
