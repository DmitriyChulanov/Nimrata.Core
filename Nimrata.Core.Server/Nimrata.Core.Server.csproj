<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ee3ba043-8863-4e77-a16d-66477e0735ee</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <SpaRoot>..\nimrata.core.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:61625</SpaProxyServerUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="dbup-postgresql" Version="7.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.*-*</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.2-preview.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
  </ItemGroup>

  <!-- SkipClientBuild=true: клиент уже собран снаружи (Docker-стадия client), dist лежит в $(SpaRoot)\dist. -->
  <ItemGroup Condition="'$(SkipClientBuild)' != 'true'">
    <ProjectReference Include="..\nimrata.core.client\nimrata.core.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!-- Публикация: собираем клиент (npm ci + npm run build) и кладём dist в wwwroot опубликованного приложения. -->
  <Target Name="BuildClientForPublish" BeforeTargets="ComputeResolvedFilesToPublishList">
    <Exec Condition="'$(SkipClientBuild)' != 'true'" Command="npm ci" WorkingDirectory="$(SpaRoot)" />
    <Exec Condition="'$(SkipClientBuild)' != 'true'" Command="npm run build" WorkingDirectory="$(SpaRoot)" />
    <ItemGroup>
      <ClientDist Include="$(SpaRoot)\dist\**\*" />
      <ResolvedFileToPublish Include="@(ClientDist)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>

